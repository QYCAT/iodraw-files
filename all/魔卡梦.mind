c0rdy0dc0","created":1786879790559,"text":"海洋"},"children":[{"data":{"id":"dkqc10lg0iw0","created":1786879810603,"text":"艾伦、寄生兽、"},"children":[]}]},{"data":{"id":"dkqc963jq600","created":1786880449495,"text":"地图彩蛋"},"children":[{"data":{"id":"dkqc9enebhc0","created":1786880468110,"text":"愤怒的小鸟，这有一个弹弓，似乎可以发射鸟类"},"children":[]}]},{"data":{"id":"dkqhuvr0dkg0","created":1786896256530,"text":"地图场景"},"children":[{"data":{"id":"dkqhuzhdetc0","created":1786896264655,"text":"类《星露谷物语》的像素风格"},"children":[]}]}]},{"data":{"id":"dkqbzmywlp40","created":1786879702578,"text":"常驻NPC","layout_mind_offset":{"x":1256.249981280417,"y":578.749991375953},"layout":null},"children":[{"data":{"id":"dkqbzu3nbcg0","created":1786879718102,"text":"哆啦A梦","layout":null,"expandState":"expand","layout_right_offset":{"x":19.999999701977003,"y":-14.999999776482582}},"children":[{"data":{"id":"dkqc01rdazk0","created":1786879734774,"text":"玩家使用想象来索取道具，然后接入ai，来引导或者计算出，最适合玩家的道具","layout_left_offset":{"x":-5.3333333333332575,"y":0},"layout":null},"children":[]},{"data":{"id":"dkr1vmvwfs80","created":1786952737797,"text":"商店可以购买铜锣烧，然后玩家每天登录领取一次随机卡片"},"children":[]}]}]},{"data":{"id":"dkqc0ecmw400","created":1786879762181,"text":"AI","layout_mind_offset":{"x":-286.333330315848,"y":-104.33333091189456},"expandState":"expand"},"children":[{"data":{"id":"dkqc0gsdb6w0","created":1786879767486,"text":"游戏角色，基于角色性格，接入简单ai对话系统","layout_left_offset":{"x":-17.333333333333258,"y":-15.333333333333314}},"children":[]}]},{"data":{"id":"dkqcekv7is00","created":1786880873464,"text":"地图建筑/交互","layout_mind_offset":{"x":-276.9999972432853,"y":-416.7499948032198}},"children":[{"data":{"id":"dkqcepcj6uo0","created":1786880883218,"text":"老虎机"},"children":[{"data":{"id":"dkqcesav7so0","created":1786880889648,"text":"老虎机，禁止赌博，有没有什么能力能让老虎机出bug，然后玩家有更多钱"},"children":[]}]},{"data":{"id":"dkqcqg87db40","created":1786881803735,"text":"商店系统"},"children":[{"data":{"id":"dkqiutfi3c00","created":1786899072591,"text":"售卖卡牌"},"children":[]},{"data":{"id":"dkqiv20uc4g0","created":1786899091296,"text":"货币系统"},"children":[{"data":{"id":"dkqiv9j7wow0","created":1786899107644,"text":"通过每次战斗，敌人掉落货币\n大世界探索得到货币","layout_left_offset":{"x":-25.33333333333337,"y":-9.333333333333314}},"children":[]}]}]}]},{"data":{"id":"dkqfwu79bwo0","created":1786890767668,"text":"玩法","layout_mind_offset":{"x":-268.4999966844915,"y":-42.16666431973414},"expandState":"expand"},"children":[{"data":{"id":"dkqfx4lqr1c0","created":1786890790311,"text":"获取可战斗角色魔卡之后，因为被封印在卡片中，能力会被限制","layout_left_offset":{"x":-54.666666666666515,"y":98.66666666666674}},"children":[]},{"data":{"id":"dkqfz7dpg2o0","created":1786890953084,"text":"背景：\n魔法世界，魔法长老们构析平行世界各个世界能力与媒体记忆能力，将无数种“奇思妙想”保存在魔卡中。\n多年前，心术不正法师（图鉴控）为了获取更多未知卡牌，袭击魔卡阁，数以万计魔卡流落世间。\n你作为即将毕业魔卡学子，只有游历并收集100张卡牌，才能毕业。为此，你开始了你的收集魔卡之旅……","layout_left_offset":{"x":6.000000000000227,"y":-70.66666666666646}},"children":[]},{"data":{"id":"dkqir3h3hio0","created":1786898780999,"text":"玩法循环","layout_left_offset":{"x":-84,"y":52}},"children":[{"data":{"id":"dkqir8h8wq80","created":1786898791892,"text":"核心玩法：探索地图-获取卡牌，循环\n1探索-遭遇敌人战斗-获取新卡牌\n2探索-遇到NPC-对话/完成委托-获取新卡牌\n3探索-发现可交互道具/解密游戏-获取新卡牌","layout":null},"children":[]}]}]},{"data":{"id":"dkqixhy13a80","created":1786899282682,"text":"数据存档","layout_mind_offset":{"x":-232.49999653548002,"y":163.74999755993485}},"children":[]},{"data":{"id":"dkr1y1jaed40","created":1786952926415,"text":"卡牌","layout_mind_offset":{"x":890,"y":-567}},"children":[{"data":{"id":"dkr1y8mr0j40","created":1786952941862,"text":"卡牌耐久"},"children":[{"data":{"id":"dkr1ydme5hc0","created":1786952952724,"text":"一次性消耗卡，cd卡，永久卡卡"},"children":[]}]},{"data":{"id":"dkr1y9r33i00","created":1786952944301,"text":"卡牌种类"},"children":[{"data":{"id":"dkr31be0o2o0","created":1786956004066,"text":"道具卡，能力卡，角色卡"},"children":[]}]},{"data":{"id":"dkr1yajo5yo0","created":1786952946029,"text":"cd卡"},"children":[]}]}]},"template":"default","theme":"fresh-green","version":"1.4.43"}